#!/bin/bash
set -euo pipefail

# binary-version: ${source_hash}
# Included so that a new binary upload produces a new launch template version,
# triggering ASG instance refresh without any manual intervention.

# Configure AWS CLI to use the dual-stack S3 endpoint.
# Instances are IPv6-only (no IPv4 public address), so the default
# IPv4-only S3 endpoint is unreachable.

mkdir -p /root/.aws
cat > /root/.aws/config <<'EOF'
[default]
use_dualstack_endpoint = true
EOF

# Configure SSM agent to use dual-stack endpoints so it can reach AWS APIs
# over IPv6. The *.api.aws hostnames have AAAA records; the default
# *.amazonaws.com hostnames are IPv4-only.
mkdir -p /etc/amazon/ssm
cat > /etc/amazon/ssm/amazon-ssm-agent.json <<EOF
{
  "Agent": { "Region": "us-east-1", "UseDualStackEndpoint": true }
}
EOF
systemctl restart amazon-ssm-agent

# Pull the latest binary from S3 before each start.
cat > /usr/local/bin/connect-update <<'EOF'
#!/bin/bash
set -e
aws s3 cp ${binary_s3_uri} /usr/local/bin/connect
chmod +x /usr/local/bin/connect
EOF
chmod +x /usr/local/bin/connect-update

cat > /etc/systemd/system/connect.service <<'EOF'
[Unit]
Description=Connect Signaling Server
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/usr/local/bin/connect-update
ExecStart=/usr/local/bin/connect ${args}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable connect
systemctl start connect
